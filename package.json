{
  "name": "react-contributions",
  "version": "2.0.0",
  "description": "Show your contributions calendar",
  "main": "index.js",
  "repository": "https://github.com/s4kr4/react-contributions",
  "author": "s4kr4",
  "license": "MIT",
  "homepage": "https://github.com/s4kr4/react-contributions#readme",
  "bugs": {
    "url": "https://github.com/s4kr4/react-contributions/issues"
  },
  "devDependencies": {
    "@babel/cli": "^8.1.0",
    "@babel/core": "^8.1.0",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-transform-runtime": "^8.0.6",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-flow": "^8.0.1",
    "@babel/preset-react": "^8.0.1",
    "@babel/register": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "chai": "^6.3.0",
    "eslint": "^10.14.0",
    "flow-bin": "^0.54.0",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "mocha": "^12.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sinon": "^22.1.0"
  },
  "dependencies": {
    "@babel/runtime": "^8.1.0",
    "axios": "^1.21.0",
    "moment": "^2.31.0"
  },
  "peerDependencies": {
    "react": "^16.14.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.14.0 || ^17.0.0 || ^18.0.0"
  },
  "scripts": {
    "dev": "babel src --out-dir lib --watch --source-maps inline",
    "build": "babel src --out-dir lib",
    "lint": "eslint src",
    "test": "mocha --require @babel/register --require test/setup.js \"test/*.spec.js\""
  },
  "files": [
    "index.js",
    "lib"
  ],
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "modules": "commonjs",
          "targets": {
            "browsers": [
              "last 2 versions",
              "safari >= 7"
            ]
          }
        }
      ],
      [
        "@babel/preset-react",
        {
          "runtime": "automatic",
          "development": false
        }
      ],
      "@babel/preset-flow"
    ],
    "plugins": [
      "@babel/plugin-transform-runtime"
    ]
  },
  "resolutions": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
}
